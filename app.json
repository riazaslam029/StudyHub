{
  "expo": {
    "name": "StudyHub",
    "slug": "studyhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1E1D"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.studyhub.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1E1D"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#D66A3B"
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow StudyHub to turn your speech into notes and tasks.",
          "speechRecognitionPermission": "Allow StudyHub to recognize your speech."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "75744a2f-2406-4ecc-93bd-a427d9d5a431"
      }
    }
  }
}
